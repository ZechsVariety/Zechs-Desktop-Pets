<?xml version="1.0" encoding="utf-8"?>
<animations xmlns:xsd="https://esheep.petrucci.ch/ https://raw.githubusercontent.com/Adrianotiger/desktopPet/master/Resources/animations.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://esheep.petrucci.ch/">
  <header>
    <author>Zecheriah</author>
    <title>Lemmings</title>
    <petname>Lemming</petname>
    <version>0.1</version>
    <info>The Lemming tribe has arrived to dethrone Pingus as the best DesktopPet! (Except not really because Lemming is moreso for me to get used to the pet editor.)[br] It literally just walks left and right. [br][br][br]Sprites are from Lemmings 1</info>
    <application>1</application>
    <icon><![CDATA[]]></icon>
  </header>
  <image>
    <tilesx>8</tilesx>
    <tilesy>2</tilesy>
    <png><![CDATA[]]></png>
    <transparency>Magenta</transparency>
  </image>
  <spawns>
    <spawn id="1" probability="20">
      <x>screenW*random/100</x>
      <y>-imageH*2</y>
      <next probability="0">3</next>
    </spawn>
  </spawns>
  <animations>
    <animation id="1">
      <name>walk</name>
      <start>
        <x>-3</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>75</interval>
      </start>
      <end>
        <x>-3</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>75</interval>
      </end>
      <sequence repeatfrom="0" repeat="40">
        <frame>7</frame>
        <frame>6</frame>
        <frame>5</frame>
        <frame>4</frame>
        <frame>3</frame>
        <frame>2</frame>
        <frame>1</frame>
        <frame>0</frame>
        <next probability="50" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="10" only="none">2</next>
        <next probability="10" only="window">1</next>
      </border>
      <gravity>
        <next probability="10" only="none">4</next>
      </gravity>
    </animation>
    <animation id="2">
      <name>rotate1</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>5</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>5</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>1</frame>
        <next probability="50" only="none">1</next>
        <action>flip</action>
      </sequence>
    </animation>
    <animation id="3">
      <name>spawn</name>
      <start>
        <x>0</x>
        <y>5</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>40</interval>
      </start>
      <end>
        <x>0</x>
        <y>5</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>40</interval>
      </end>
      <sequence repeatfrom="0" repeat="10">
        <frame>6</frame>
        <next probability="100" only="none">4</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="4">
      <name>fall</name>
      <start>
        <x>0</x>
        <y>5</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>40</interval>
      </start>
      <end>
        <x>0</x>
        <y>5</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>40</interval>
      </end>
      <sequence repeatfrom="0" repeat="500">
        <frame>0</frame>
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <frame>4</frame>
        <frame>5</frame>
        <frame>6</frame>
        <frame>7</frame>
        <next probability="10" only="none">4</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="10" only="none">1</next>
      </border>
    </animation>
  </animations>
  <childs />
  <sounds>
    <sound animationid="3">
      <probability>100</probability>
      <base64></base64>
    </sound>
  </sounds>
</animations>