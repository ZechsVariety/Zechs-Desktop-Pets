<?xml version="1.0" encoding="utf-8"?>
<animations xmlns:xsd="https://esheep.petrucci.ch/ https://raw.githubusercontent.com/Adrianotiger/desktopPet/master/Resources/animations.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://esheep.petrucci.ch/">
  <header>
    <author>Zecheriah</author>
    <title>Mortimer</title>
    <petname>Mortimer</petname>
    <version>0.2</version>
    <info>Info about pet type shit</info>
    <application>1</application>
    <icon><![CDATA[]]></icon>
  </header>
  <image>
    <tilesx>7</tilesx>
    <tilesy>1</tilesy>
    <png><![CDATA[]]></png>
    <transparency>Magenta</transparency>
  </image>
  <spawns>
    <spawn id="1" probability="20">
      <x>screenW+10</x>
      <y>areaH-imageH</y>
      <next probability="100">1</next>
    </spawn>
  </spawns>
  <animations>
    <animation id="1">
      <name>walk</name>
      <start>
        <x>-4</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </start>
      <end>
        <x>-4</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </end>
      <sequence repeatfrom="0" repeat="20">
        <frame>3</frame>
        <frame>4</frame>
        <frame>5</frame>
        <frame>6</frame>
        <next probability="50" only="none">1</next>
        <next probability="10" only="none">4</next>
        <next probability="10" only="none">2</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="50" only="none">2</next>
      </border>
    </animation>
    <animation id="2">
      <name>rotate a</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>0</frame>
        <next probability="50" only="none">3</next>
        <action>flip</action>
      </sequence>
    </animation>
    <animation id="3">
      <name>rotate b</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>200</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>0</frame>
        <next probability="10" only="none">1</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="4">
      <name>Idle</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>100</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>100</interval>
      </end>
      <sequence repeatfrom="0" repeat="20">
        <frame>0</frame>
        <next probability="10" only="none">1</next>
        <next probability="10" only="none">4</next>
        <next probability="10" only="none">5</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="5">
      <name>Blink</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>100</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>100</interval>
      </end>
      <sequence repeatfrom="0" repeat="5">
        <frame>1</frame>
        <next probability="10" only="none">4</next>
        <action>none</action>
      </sequence>
    </animation>
  </animations>
  <childs />
</animations>